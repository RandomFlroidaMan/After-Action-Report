# Leave unset for embedded PostgreSQL (PGlite), single-process local development.
# DATABASE_URL=postgresql://aar:aar_local_only@localhost:5432/aar
AAR_DATA_DIR=./.data
# Optional official transcription provider; no external calls without configuration.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# AUTH_COOKIE_SECURE=true
# Worker for network PostgreSQL only: DATABASE_URL required.
# APP_ORIGIN=https://aar.example.com
# Explicit Chat Completions model supporting strict JSON-schema structured outputs.
# OPENAI_EXTRACTION_MODEL=

# Managed cloud uses these aliases (OPENAI_ secret bindings are reserved):
# AAR_OPENAI_API_KEY=   # enter securely in environment settings, never in source
# AAR_EXTRACTION_MODEL=gpt-4.1-mini

# Vercel: connect Neon (DATABASE_URL or POSTGRES_URL) and a PRIVATE Blob store.
# These values must also be configured in Vercel; cloud-chat secrets do not transfer.
# POSTGRES_URL=
# BLOB_READ_WRITE_TOKEN=
# AAR_REGISTRATION_CODE=  # choose a private phrase 24-256 characters long
